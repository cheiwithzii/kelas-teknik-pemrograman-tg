import sqlite3

# Reconnect to an in-memory SQLite database
# NOTE: In a fresh run, this creates a new empty database.
#       If you run this cell after previous cells in the same session, 
#       it will connect to the existing in-memory database.
conn = sqlite3.connect(':memory:')
cursor = conn.cursor()

# Ensure the 'survey' table exists (re-creation with IF NOT EXISTS for robustness)
cursor.execute("""
CREATE TABLE IF NOT EXISTS survey (
    id_survey INTEGER PRIMARY KEY NOT NULL,
    nama_survey TEXT NOT NULL,
    lokasi TEXT,
    tanggal TEXT,
    metode TEXT
);
""")

# Insert the initial survey data if not already present (id_survey=1)
# This is to ensure context if the database is reset or if this cell is run first.
cursor.execute("""
INSERT OR IGNORE INTO survey (id_survey, nama_survey, lokasi, tanggal, metode)
VALUES (1, 'Survei Geolistrik C', 'Metro', '2025-05-15', 'Resistivitas');
""")

# --- INSERT data baru ke tabel 'survey' sesuai permintaan (menggunakan id_survey=2) ---
cursor.execute("""
INSERT INTO survey (id_survey, nama_survey, lokasi, tanggal, metode)
VALUES (2, 'Survei Geolistrik C', 'Metro', '2025-05-15', 'Resistivitas');
""")

# Commit the changes for the new insertion
conn.commit()

print("Data baru berhasil dimasukkan ke tabel 'survey'.")

# --- SELECT nama_survey dan lokasi dari tabel survey ---
print("\nNama Survey dan Lokasi dari tabel 'survey':")
cursor.execute("SELECT nama_survey, lokasi FROM survey;")

# Fetch and print the results
rows = cursor.fetchall()
for row in rows:
    print(row)

# Close the connection
conn.close()
