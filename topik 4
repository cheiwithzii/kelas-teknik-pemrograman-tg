# 1. DAFTAR BELANJA
# ============================================

daftar_belanja = []  # membuat list kosong

print("=== Program Daftar Belanja ===")
for i in range(3):
    barang = input(f"Masukkan barang ke-{i+1}: ")
    daftar_belanja.append(barang)

print("\nDaftar belanja final:", daftar_belanja)


