import sqlite3

# Reconnect to an in-memory SQLite database
conn = sqlite3.connect(':memory:')
cursor = conn.cursor()

# Re-create the survey table (if not already exists from a previous run)
cursor.execute("""
CREATE TABLE IF NOT EXISTS survey (
    id_survey INTEGER PRIMARY KEY NOT NULL,
    nama_survey TEXT NOT NULL,
    lokasi TEXT,
    tanggal TEXT,
    metode TEXT
);
""")

# Re-create the Data_Seismik table (if not already exists from a previous run)
cursor.execute("""
CREATE TABLE IF NOT EXISTS Data_Seismik (
    id_data INTEGER PRIMARY KEY AUTOINCREMENT,
    id_survey INTEGER,
    titik_x REAL,
    titik_y REAL,
    amplitudo REAL,
    waktu_tiba REAL,
    FOREIGN KEY (id_survey) REFERENCES survey(id_survey)
);
""")

# Insert data into survey table if not already present (to satisfy foreign key constraint)
cursor.execute("""
INSERT OR IGNORE INTO survey (id_survey, nama_survey, lokasi, tanggal, metode)
VALUES (1, 'Survei Geolistrik C', 'Metro', '2025-05-15', 'Resistivitas');
""")

# INSERT data into Data_Seismik table
# id_survey merujuk ke id_survey di tabel survey
# id_data akan otomatis diisi karena AUTOINCREMENT
cursor.execute("""
INSERT INTO Data_Seismik (id_survey, titik_x, titik_y, amplitudo, waktu_tiba)
VALUES (1, 10.5, 20.3, 0.75, 0.12);
""")

cursor.execute("""
INSERT INTO Data_Seismik (id_survey, titik_x, titik_y, amplitudo, waktu_tiba)
VALUES (1, 11.2, 21.0, 0.82, 0.15);
""")

# Commit the changes
conn.commit()

print("Data berhasil dimasukkan ke tabel Data_Seismik.")

# Verify insertion by selecting data
print("\nIsi tabel Data_Seismik setelah insertion:")
cursor.execute("SELECT * FROM Data_Seismik;")
rows = cursor.fetchall()
for row in rows:
    print(row)

# Close the connection
conn.close()
